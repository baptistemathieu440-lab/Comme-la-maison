# Copier ce fichier en .env.local et le compléter. Ne jamais committer .env.local.

# Adresse publique du site, sans barre finale (utilisée pour le référencement et le partage).
# Sur Vercel, l'adresse de production est détectée automatiquement si cette variable est vide.
NEXT_PUBLIC_SITE_URL=https://www.votre-domaine.fr

# Envoi des demandes du formulaire par email, via Resend (https://resend.com).
RESEND_API_KEY=
# Adresse(s) qui reçoivent les demandes, séparées par des virgules.
CONTACT_TO_EMAIL=
# Expéditeur des emails (domaine à vérifier dans Resend).
CONTACT_FROM_EMAIL="Comme à la Maison <contact@votre-domaine.fr>"

# "log" : les demandes sont écrites dans les journaux du serveur au lieu d'être envoyées
# (utile pour une préproduction). À laisser vide en production.
CONTACT_DELIVERY=
