# Copier ce fichier en .env.local et le compléter. Ne jamais committer .env.local.
# Sur Netlify : Site configuration › Environment variables (mêmes noms).

# Adresse publique du site, sans barre finale (référencement, liens d'invitation, calendriers iCal).
NEXT_PUBLIC_SITE_URL=https://comme-a-la-maison.netlify.app

# --- Plateforme de gestion (Supabase, région Paris) --------------------------------------
# Tableau de bord Supabase › Project Settings › API.
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable (sb_publishable_…) : sans danger côté navigateur, les règles d'accès s'appliquent.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…) : contourne les règles d'accès. Serveur uniquement, jamais NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Clé de chiffrement des IBAN : 32 octets en base64, générée une fois et conservée précieusement.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IBAN_ENCRYPTION_KEY=

# Secret partagé avec les tâches planifiées Netlify (netlify/functions/cron-*.mts).
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Emails (facultatif, nécessite un nom de domaine vérifié chez Resend) ----------------
# Sans ces variables : rien n'est envoyé, les liens d'invitation s'affichent pour être transmis
# à la main et les notifications restent dans l'application.
RESEND_API_KEY=
EMAIL_FROM="Comme à la Maison <bonjour@votre-domaine.fr>"

# Formulaire d'estimation du site : destinataires des demandes par email (en plus du CRM).
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Comme à la Maison <contact@votre-domaine.fr>"
# "log" : les demandes sont écrites dans les journaux du serveur au lieu d'être envoyées
# (préproduction, tests). À laisser vide en production.
CONTACT_DELIVERY=
